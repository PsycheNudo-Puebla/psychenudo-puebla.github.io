<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Panel del Profesor</title>

    <!-- QRCode library (carga global, no ESM) -->
    <script src="js/qrcode.min.js"></script>


  <script type="module" crossorigin src="./src/main-profesor.ts"></script>
</head>
<body>
    <!-- VISTA DE LOGIN -->
    <div id="login-view" class="container">
        <h1>👨‍🏫 Acceso del Profesor</h1>
        
        <div class="card">
            <div id="login-tabs">
                <button class="tab active" onclick="showTab('login', event)">Iniciar Sesión</button>
                <button class="tab" onclick="showTab('register', event)">Registrarse</button>
            </div>
            
            <!-- Formulario de Login -->
            <form id="login-form" onsubmit="handleLogin(event)">
                <h3>Iniciar Sesión</h3>
                <input type="email" id="login-email" placeholder="Email" required>
                <input type="password" id="login-password" placeholder="Contraseña" required>
                <button type="submit" class="btn-primary" id="btn-login">Entrar</button>
                <div id="login-error" class="error-msg"></div>
                <p style="text-align:center; margin-top:4px;">
                    <a href="#" onclick="handleResetPassword(event)" style="color:#667eea; font-size:0.85em; text-decoration:none;">¿Olvidaste tu contraseña?</a>
                </p>
            </form>
            
            <!-- Formulario de Registro -->
            <form id="register-form" class="hidden" onsubmit="handleRegister(event)">
                <h3>Registro de Profesor</h3>
                <input type="text" id="reg-nombre" placeholder="Nombre completo" required>
                <input type="email" id="reg-email" placeholder="Email" required>
                <input type="password" id="reg-password" placeholder="Contraseña (mín. 6 caracteres)" required minlength="6">
                <button type="submit" class="btn-primary" id="btn-register">Registrarme</button>
                <div id="register-error" class="error-msg"></div>
            </form>


        </div>
        
        <a href="index.html" class="back-link">← Volver al inicio</a>
    </div>
    
    <!-- VISTA DEL DASHBOARD (oculta hasta login) -->
    <div id="dashboard-view" class="container hidden">
        <header class="dashboard-header">
            <h1>👨‍🏫 Panel del Profesor</h1>
            <div>
                <span id="profesor-nombre"></span>
                <button onclick="handleLogout()" class="btn-secondary">Cerrar sesión</button>
            </div>
        </header>
        
        <!-- VISTA LISTA DE GRUPOS (master) -->
        <div id="grupos-list-view">
            <div class="card">
                <h2>Mis Grupos</h2>
                <button onclick="showCreateGroupModal()" class="btn-primary">+ Crear nuevo grupo</button>
                <div id="grupos-lista" class="list-container">
                    <p class="empty-state">No tienes grupos aún. Crea uno para empezar.</p>
                </div>
            </div>
        </div>

        <!-- VISTA DETALLE DEL GRUPO (detail) -->
        <div id="grupo-detalle-view" class="hidden">
            <div class="card" style="position:relative;">
                <button onclick="volverALista()" style="background:none; border:none; color:#667eea; cursor:pointer; font-size:0.9em; margin-bottom:10px; display:flex; align-items:center; gap:4px;">
                    ← Volver a mis grupos
                </button>
                
                <!-- Cabecera del grupo -->
                <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px;">
                    <div>
                        <h2 id="detalle-grupo-nombre" style="margin:0;"></h2>
                        <p id="detalle-grupo-materia" style="color:#666; font-size:0.9em; margin:4px 0 0;"></p>
                    </div>
                    <div style="text-align:right;">
                        <div style="font-size:0.75em; color:#667eea; font-weight:600;">🔑 CÓDIGO</div>
                        <div id="detalle-grupo-codigo" style="font-size:1.3em; font-family:monospace; letter-spacing:3px; font-weight:700;"></div>
                    </div>
                </div>

                <!-- Resumen de horarios -->
                <div id="detalle-grupo-horarios" style="margin:12px 0; font-size:0.85em; color:#555;"></div>

                <!-- Acciones del grupo -->
                <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; padding-top:12px; border-top:1px solid #eee;">
                    <button id="detalle-btn-qr" class="btn-qr" style="flex:1; min-width:80px;">📷 QR</button>
                    <button id="detalle-btn-monitoreo" class="btn-secondary" style="flex:1; min-width:80px;">📡 Monitoreo</button>
                    <button id="detalle-btn-exportar" class="btn-secondary" style="flex:1; min-width:80px;">📊 Excel</button>
                    <button id="detalle-btn-ver" class="btn-secondary" style="flex:1; min-width:80px;">📋 Ver</button>
                    <button id="detalle-btn-editar" class="btn-secondary" style="flex:1; min-width:80px;">✏️ Editar</button>
                </div>
            </div>

            <!-- Monitoreo en vivo (dentro del detalle) -->
            <div id="monitoreo-panel" class="card hidden">
                <h2 style="display: flex; align-items: center; gap: 8px; justify-content: center;">
                    <span>📊 Monitoreo en Vivo</span>
                    <span id="monitoreo-estado-badge" style="font-size: 0.6em; background: #4caf50; color: white; padding: 3px 10px; border-radius: 20px;">ACTIVO</span>
                </h2>
                <p style="text-align: center; color: #666; font-size: 0.85em; margin-bottom: 12px;">
                    Grupo: <strong id="monitoreo-grupo-nombre"></strong> 
                    · Perdones: <span id="monitoreo-perdones-usados">0</span>/<span id="monitoreo-perdones-max">2</span>
                    · <span id="monitoreo-alumnos-count">0</span> alumnos
                </p>
                <div id="monitoreo-lista" class="list-container" style="max-height: 400px; overflow-y: auto;">
                    <p class="empty-state">Esperando que los alumnos escaneen el QR...</p>
                </div>
                <div style="text-align: center; margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;">
                    <button onclick="resetearContadoresHoy()" class="btn-secondary" style="flex:1; min-width:120px; font-size:0.85em; background:#fff3e0; color:#e65100; border:1px solid #ffe0b2;">🔄 Resetear pantallas (hoy)</button>
                    <button onclick="cerrarMonitoreo()" class="btn-secondary" style="flex:1; min-width:120px;">Cerrar monitoreo</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- MODAL: Crear grupo -->
    <div id="modal-crear-grupo" class="modal-overlay hidden" onclick="if(event.target===this) cerrarModal()">
        <div class="modal" style="max-width: 580px;">
            <h2 id="modal-crear-grupo-title">📚 Crear nuevo grupo</h2>
            <form id="form-crear-grupo" onsubmit="return handleGuardarGrupo(event)">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px;">
                    <div style="grid-column: span 2;">
                        <label>Nombre del grupo</label>
                        <input type="text" id="grupo-nombre" placeholder="Ej. Grupo 301 - Matemáticas" required>
                    </div>
                    <div>
                        <label>Materia (opcional)</label>
                        <input type="text" id="grupo-materia" placeholder="Ej. Matemáticas">
                    </div>
                    <div>
                        <label>Código de grupo</label>
                        <div style="display: flex; gap: 6px;">
                            <input type="text" id="grupo-codigo" placeholder="Generado auto" readonly style="flex:1; background:#f5f5f5; font-family:monospace; letter-spacing:2px;">
                            <button type="button" onclick="generarNuevoCodigo()" style="padding: 8px 12px; border:1px solid #ddd; border-radius:8px; background:white; cursor:pointer;">🔄</button>
                        </div>
                    </div>
                    <div>
                        <label>Límite de cambios</label>
                        <input type="number" id="grupo-limite" value="3" min="1" max="15" required>
                    </div>
                    <div>
                        <label>Número de perdones</label>
                        <input type="number" id="grupo-perdones" value="2" min="0" max="10" required>
                    </div>
                </div>

                <!-- HORARIOS: selector día + hora -->
                <hr style="margin: 12px 0; border: none; border-top: 2px solid #f0f0f0;">
                <label style="font-weight: 600; color:#333; font-size:0.95em; margin-bottom: 4px; display: block;">📅 Horarios de clase</label>
                <p style="font-size:0.8em; color:#999; margin:0 0 8px;">Agrega uno o más horarios por día. 🟢 puntual → 🟡 retardo → ❌ cerrado.</p>

                <!-- Lista de horarios agregados -->
                <div id="lista-horarios-creados" style="display:flex; flex-direction:column; gap:6px; margin-bottom:12px;">
                    <span style="color:#999; font-size:0.9em; padding:8px;">No hay horarios agregados.</span>
                </div>

                <!-- Formulario para agregar nuevo horario -->
                <div id="crear-horarios-dias-container" style="background:#f8f9ff; border-radius:12px; padding:12px; margin-bottom:8px;">
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                        <div>
                            <label style="font-size:0.8em; color:#888;">Día</label>
                            <select id="nuevo-horario-dia" style="width:100%; padding:9px; border:2px solid #e0e0e0; border-radius:10px; font-size:14px;">
                                <option value="1">Lunes</option>
                                <option value="2">Martes</option>
                                <option value="3">Miércoles</option>
                                <option value="4">Jueves</option>
                                <option value="5">Viernes</option>
                                <option value="6">Sábado</option>
                                <option value="0">Domingo</option>
                            </select>
                        </div>
                        <div>
                            <label style="font-size:0.8em; color:#888;">Inicio</label>
                            <input type="time" id="nuevo-horario-inicio" style="width:100%; padding:9px; border:2px solid #e0e0e0; border-radius:10px; font-size:14px;">
                        </div>
                        <div>
                            <label style="font-size:0.8em; color:#888;">Fin</label>
                            <input type="time" id="nuevo-horario-fin" style="width:100%; padding:9px; border:2px solid #e0e0e0; border-radius:10px; font-size:14px;">
                        </div>
                        <div>
                            <label style="font-size:0.8em; color:#888;">🟢 Puntual (min)</label>
                            <input type="number" id="nuevo-horario-puntual" value="10" min="1" max="60" style="width:100%; padding:9px; border:2px solid #e0e0e0; border-radius:10px; font-size:14px;">
                        </div>
                        <div>
                            <label style="font-size:0.8em; color:#888;">🟡 Retardo (min)</label>
                            <input type="number" id="nuevo-horario-retardo" value="20" min="1" max="120" style="width:100%; padding:9px; border:2px solid #e0e0e0; border-radius:10px; font-size:14px;">
                        </div>
                        <div>
                            <label style="font-size:0.8em; color:#888;">📍 Radio GPS (m)</label>
                            <input type="number" id="nuevo-horario-radio" value="50" min="10" max="500" style="width:100%; padding:9px; border:2px solid #e0e0e0; border-radius:10px; font-size:14px;">
                        </div>
                        <div>
                            <label style="font-size:0.8em; color:#888;">Latitud</label>
                            <input type="number" step="any" id="nuevo-horario-lat" placeholder="Opcional" style="width:100%; padding:9px; border:2px solid #e0e0e0; border-radius:10px; font-size:14px;">
                        </div>
                        <div>
                            <label style="font-size:0.8em; color:#888;">Longitud</label>
                            <input type="number" step="any" id="nuevo-horario-lng" placeholder="Opcional" style="width:100%; padding:9px; border:2px solid #e0e0e0; border-radius:10px; font-size:14px;">
                        </div>
                        <div style="grid-column: span 2;">
                            <button type="button" onclick="obtenerUbicacion()" style="width:100%; padding:10px; background:#e8f5e9; border:2px solid #a5d6a7; border-radius:10px; cursor:pointer; font-size:14px; color:#2e7d32;">
                                📍 Obtener mi ubicación actual
                            </button>
                        </div>
                    </div>
                    <button type="button" onclick="agregarHorarioFormulario()" style="margin-top:8px; width:100%; padding:10px; background:#e8edf5; border:2px dashed #c0c8e0; border-radius:10px; cursor:pointer; font-size:14px; color:#555;">+ Agregar horario</button>
                </div>

                <!-- GPS (cada horario puede tener su propia ubicación) -->
                <p style="font-size:0.85em; color:#888; margin:8px 0 0 0;">
                    📍 La ubicación GPS se configura <strong>por horario</strong> abajo en la sección "Agregar horario".
                    Cada día/clase puede tener su propio salón.
                </p>

                <div class="modal-buttons" style="margin-top: 16px;">
                    <button type="button" onclick="cerrarModal()" class="btn-secondary">Cancelar</button>
                    <button type="submit" id="btn-guardar-grupo" class="btn-primary">✅ Crear grupo</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: QR de asistencia -->
    <div id="modal-qr" class="modal-overlay hidden" onclick="if(event.target===this) cerrarQR()">
        <div class="modal modal-qr">
            <h3>📷 Código QR de Asistencia</h3>
            <p style="color: #666; text-align: center; font-size: 0.9em; margin-bottom: 5px;">
                <strong id="qr-grupo-nombre"></strong> · <span id="qr-timer">⏳ Generando...</span>
            </p>
            <p id="qr-estado" style="color: #2e7d32; font-weight:700; text-align: center; font-size: 0.9em; margin-bottom: 10px;"></p>
            <div id="qr-code-container" class="qr-code-container">
                <div id="qrcode"></div>
            </div>
            <p id="qr-mensaje-alumno" style="color: #666; text-align: center; font-size: 0.85em;"></p>
            <div class="modal-buttons" style="flex-direction: column; gap: 8px;">
                <button onclick="cerrarQR()" class="btn-secondary" style="width: 100%;">Cerrar</button>
            </div>
        </div>
    </div>

    <!-- MODAL: Horarios (redirigido al modal de edición por JS) -->
    <!-- MODAL: Ver asistencias del grupo -->
    <div id="modal-ver-grupo" class="modal-overlay hidden" onclick="if(event.target===this) cerrarModalVer()">
        <div class="modal" style="max-width: 800px;">
            <h3>📋 Asistencias del grupo</h3>
            <p id="ver-grupo-info" style="color: #666; font-size: 0.9em; margin-bottom: 8px;"></p>
            
            <!-- Filtros mejorados -->
            <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px; flex-wrap: wrap;">
                <span style="font-weight:600; font-size:0.85em; color:#555;">Alumno:</span>
                <select id="ver-filtro-alumno" style="flex:1; min-width:140px; padding:9px 10px; border:2px solid #e0e0e0; border-radius:10px; font-size:14px;">
                    <option value="">— Todos —</option>
                </select>
                <input type="text" id="ver-buscar-alumno" placeholder="🔍 Buscar..." style="flex:1; min-width:120px; padding:9px 10px; border:2px solid #e0e0e0; border-radius:10px; font-size:14px;">
                <span style="font-weight:600; font-size:0.85em; color:#555;">Desde:</span>
                <input type="date" id="ver-filtro-desde" style="padding:9px 10px; border:2px solid #e0e0e0; border-radius:10px; font-size:14px;">
                <span style="font-weight:600; font-size:0.85em; color:#555;">Hasta:</span>
                <input type="date" id="ver-filtro-hasta" style="padding:9px 10px; border:2px solid #e0e0e0; border-radius:10px; font-size:14px;">
                <button onclick="renderVerGrupo()" class="btn-primary" style="padding:9px 18px; width:auto; font-size:14px;">Filtrar</button>
            </div>
            
            <div id="ver-grupo-contenido" style="max-height: 60vh; overflow-y: auto;">
                <p class="empty-state">Cargando...</p>
            </div>
            
            <div class="modal-buttons">
                <button onclick="cerrarModalVer()" class="btn-secondary" style="flex:1;">Cerrar</button>
            </div>
        </div>
    </div>
    
    <!-- MODAL: Editar nombre de alumno -->
    <div id="modal-editar-alumno" class="modal-overlay hidden" onclick="if(event.target===this) cerrarModalEditarAlumno()">
        <div class="modal" style="max-width: 450px;">
            <h3>✏️ Corregir nombre del alumno</h3>
            <p style="color: #666; font-size: 0.9em; margin-bottom: 12px;">
                Si el alumno registró su nombre incorrectamente, puedes corregirlo aquí.
                El cambio se aplicará en todos los registros de asistencia.
            </p>
            <div id="editar-alumno-info" style="background: #f5f7ff; border-radius: 8px; padding: 12px; margin-bottom: 12px; font-size: 0.85em;">
                <div><strong>Email:</strong> <span id="editar-alumno-email"></span></div>
                <div><strong>Matrícula:</strong> <span id="editar-alumno-matricula"></span></div>
            </div>
            <form id="form-editar-alumno" onsubmit="guardarNombreAlumno(event)">
                <input type="hidden" id="editar-alumno-id">
                <label for="editar-alumno-nombre">Nombre completo</label>
                <input type="text" id="editar-alumno-nombre" placeholder="Nombre completo del alumno" required>
                <div class="modal-buttons" style="margin-top: 16px;">
                    <button type="button" onclick="cerrarModalEditarAlumno()" class="btn-secondary">Cancelar</button>
                    <button type="submit" class="btn-primary" id="btn-guardar-nombre-alumno">💾 Guardar cambios</button>
                </div>
                <div id="editar-alumno-error" class="error-msg"></div>
            </form>
        </div>
    </div>

    <!-- Vite: modo desarrollo -> src/main-profesor.ts, build -> dist/assets/*.js -->

</body>
</html>